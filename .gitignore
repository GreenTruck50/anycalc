# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
dist/
coverage/

# --- Flet: `flet build` / `flet test` regenerate all of this (≈10 GB locally) ---
build/
.flet/

# --- MkDocs: `mkdocs build` output, and CI rebuilds it - never tracked.
#     It mirrors every word of docs/ (plus search/search_index.json flattened),
#     so committing it doubles any leak. ---
site/

# --- local environment & tooling caches ---
.venv/
.pytest_cache/
.dart_tool/

# --- editor settings (per-machine, not part of the project) ---
.vscode/

# --- misc ---
*.log
.history
*.swp
